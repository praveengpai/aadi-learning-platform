# Domains pointing (A record) at your VPS IP
CLOUD_DOMAIN=aadi-demo.example.org
HUB_DOMAIN=hub.aadi-demo.example.org
# Long random secret shared by cloud and hubs:  openssl rand -hex 32
AADI_SYNC_KEY=change-me
# Optional: limit the hub to one hamlet's data (hamlet id from the cloud). Empty = all.
AADI_HUB_HAMLETS=
