  "tables": {
    "wildlife_claims": ["submission_id", "person_id", "hamlet_id", "agency_id", "review_agency_id", "status", "amount_claimed", "amount_sanctioned", "animal", "damage", "updated_by", "note", "note_ml"],
    "wildlife_claim_log": ["claim_id", "submission_id", "person_id", "hamlet_id", "agency_id", "status", "amount", "note", "note_ml", "by_user", "by_role", "at"],
    "wildlife_sightings": ["hamlet_id", "agency_id", "animal", "seen_at", "place", "place_ml", "lat", "lng", "group_size", "direction", "note", "reported_by", "reported_by_name", "reported_role"],
    "wildlife_readings": ["hamlet_id", "agency_id", "kind", "value", "unit", "at", "device", "animal", "source", "entered_by"]
  },
  "types": {
    "amount_claimed": "INTEGER",
    "amount_sanctioned": "INTEGER",
    "amount": "INTEGER",
    "lat": "REAL",
    "lng": "REAL",
    "group_size": "INTEGER",
    "value": "REAL"
  },
  "budget": { "storage_mb": 40, "sync_priority": 2, "power": "low" },
